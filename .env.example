# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.
#
# See README.md "Connecting Google (Calendar + Tasks)" for how to get these from
# Google Cloud Console.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Photos for the idle slideshow (Admin > Display > Photos): a SECOND OAuth
# client, from its own Cloud project (External, Testing, the family's personal
# Google account added as a test user, Google Photos Picker API enabled). Its
# only scope is photospicker.mediaitems.readonly. Leave blank to turn Photos
# off; Admin then shows how to set it up. See README "Photos for the idle screen".
GOOGLE_PHOTOS_CLIENT_ID=
GOOGLE_PHOTOS_CLIENT_SECRET=

# School inbox (Admin > Add from Classroom): Claude reads Classroom screenshots,
# pasted text and school PDFs into a review inbox. Leave blank to turn it off;
# Admin then shows how to set it up. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional: which Claude model reads the documents (default claude-sonnet-5).
ANTHROPIC_MODEL=
